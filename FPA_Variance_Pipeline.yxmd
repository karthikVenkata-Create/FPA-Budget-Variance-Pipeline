    <Node ToolID="4">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula"><Position x="410" y="340" /></GuiSettings>
      <Properties><Configuration><FormulaFields><FormulaField expression='Trim(REGEX_Replace([department], "\s+", " "))' field="department_clean" size="254" type="V_String" /><FormulaField expression="Trim([month])" field="month_txt" size="254" type="V_String" /><FormulaField expression='IF REGEX_Match([month_txt], "\d{4}-\d{1,2}-\d{1,2}") THEN DateTimeTrim(DateTimeParse([month_txt], "%Y-%m-%d"), "month")&#10;ELSEIF REGEX_Match([month_txt], "\d{1,2}/\d{1,2}/\d{4}") THEN DateTimeTrim(DateTimeParse([month_txt], "%m/%d/%Y"), "month")&#10;ELSEIF REGEX_Match([month_txt], "[A-Za-z]{3} \d{4}") THEN DateTimeTrim(DateTimeParse("01 " + [month_txt], "%d %b %Y"), "month")&#10;ELSE Null() ENDIF' field="month_date" size="10" type="Date" /><FormulaField expression='REGEX_Replace(REGEX_Replace(Trim([budget]), "[$,\s]", ""), "^\((.*)\)$", "-$1")' field="budget_txt" size="254" type="V_String" /><FormulaField expression='REGEX_Replace(REGEX_Replace(Trim([actual]), "[$,\s]", ""), "^\((.*)\)$", "-$1")' field="actual_txt" size="254" type="V_String" /><FormulaField expression='IIF(REGEX_Match([budget_txt], "-?\d+(\.\d+)?"), ToNumber([budget_txt]), Null())' field="budget_num" size="8" type="Double" /><FormulaField expression='IIF(REGEX_Match([actual_txt], "-?\d+(\.\d+)?"), ToNumber([actual_txt]), Null())' field="actual_num" size="8" type="Double" /><FormulaField expression='REGEX_Replace(&#10;  IIF(IsEmpty([department_clean]), "missing department; ", "") +&#10;  IIF(IsNull([month_date]), IIF(IsEmpty([month_txt]), "missing month; ", "unreadable month; "), "") +&#10;  IIF(IsNull([budget_num]), IIF(IsEmpty([budget_txt]), "missing budget; ", "unreadable budget; "), "") +&#10;  IIF(IsNull([actual_num]), IIF(IsEmpty([actual_txt]), "missing actual; ", "unreadable actual; "), ""),&#10;";\s*$", "")' field="reason" size="254" type="V_String" /></FormulaFields></Configuration><Annotation DisplayMode="0"><Name /><AnnotationText>Parse text to numbers and dates; record why a row is bad</AnnotationText><DefaultAnnotationText /><Left value="False" /></Annotation></Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>
