    <Node ToolID="19">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula"><Position x="950" y="340" /></GuiSettings>
      <Properties><Configuration><FormulaFields><FormulaField expression="[actual_num] - [budget_num]" field="variance" size="8" type="Double" /><FormulaField expression="IIF([budget_num] &gt; 0, 1, 0)" field="budget_ok" size="4" type="Int32" /><FormulaField expression="1 - [budget_ok]" field="bad_budget" size="4" type="Int32" /><FormulaField expression="IIF([budget_ok] = 1, [variance] / [budget_num], Null())" field="variance_pct" size="8" type="Double" /><FormulaField expression="ABS([variance])" field="abs_variance" size="8" type="Double" /><FormulaField expression='IIF([variance] &gt; 0, "Unfavorable", IIF([variance] &lt; 0, "Favorable", "On budget"))' field="fav_unfav" size="20" type="V_String" /><FormulaField expression="IIF([abs_variance] &gt; [materiality_usd] AND !IsNull([variance_pct]) AND ABS([variance_pct]) &gt; [materiality_pct], 1, 0)" field="material_miss" size="4" type="Int32" /><FormulaField expression="IIF([abs_variance] &gt; [materiality_usd] AND !IsNull([variance_pct]) AND ABS([variance_pct]) &gt; [near_miss_pct_floor]&#10;    AND ABS([variance_pct]) &lt;= [materiality_pct], 1, 0)" field="near_miss" size="4" type="Int32" /><FormulaField expression="IIF([variance] &gt; 0, [variance], 0)" field="over_budget" size="8" type="Double" /><FormulaField expression="IIF([variance] &lt; 0, -[variance], 0)" field="under_budget" size="8" type="Double" /><FormulaField expression="IIF([budget_ok] = 1, [budget_num], Null())" field="budget_for_phasing" size="8" type="Double" /><FormulaField expression="IIF([budget_ok] = 0 AND !IsNull([variance_pct]), 1, 0)" field="pct_violation" size="4" type="Int32" /><FormulaField expression="[material_miss] * [near_miss]" field="both_flags" size="4" type="Int32" /><FormulaField expression='DateTimeFormat([month_date], "%b")' field="month_name" size="10" type="V_String" /></FormulaFields></Configuration><Annotation DisplayMode="0"><Name /><AnnotationText>Variance, Fav / Unfav, material and near miss</AnnotationText><DefaultAnnotationText /><Left value="False" /></Annotation></Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>
