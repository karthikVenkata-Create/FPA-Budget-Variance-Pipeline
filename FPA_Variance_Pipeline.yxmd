      <Properties><Configuration><NumRows value="1" /><Fields><Field name="materiality_usd" /><Field name="materiality_pct" /><Field name="near_miss_pct_floor" /><Field name="phasing_ratio_flag" /><Field name="allow_dropped_spend" /></Fields><Data><r><c>25000</c><c>0.05</c><c>0.04</c><c>10</c><c>0</c></r></Data></Configuration><Annotation DisplayMode="0"><Name /><AnnotationText>SETTINGS: edit thresholds here (allow_dropped_spend: 1 = report and continue)</AnnotationText><DefaultAnnotationText /><Left value="False" /></Annotation></Properties>
