    <Node ToolID="44">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula"><Position x="2370" y="1275" /></GuiSettings>
      <Properties><Configuration><FormulaFields><FormulaField expression="1 - ABS([net_variance]) / [total_budget]" field="net_accuracy" size="8" type="Double" /><FormulaField expression="1 - [gross_misses] / [total_budget]" field="gross_accuracy" size="8" type="Double" /><FormulaField expression="[gross_misses] - ABS([net_variance])" field="cancelled_out" size="8" type="Double" /><FormulaField expression="IIF([rows_read] = [rows_kept] + [rows_dropped], 1, 0)" field="chk_rows_balance" size="4" type="Int32" /><FormulaField expression="IIF([rows_no_reason] = 0, 1, 0)" field="chk_dropped_reason" size="4" type="Int32" /><FormulaField expression="IIF(ABS([dept_budget] - [total_budget]) &lt; 0.01 AND ABS([dept_actual] - [total_actual]) &lt; 0.01&#10;    AND ABS([dept_variance] - [net_variance]) &lt; 0.01, 1, 0)" field="chk_dept_totals" size="4" type="Int32" /><FormulaField expression="IIF(ABS([month_budget] - [total_budget]) &lt; 0.01 AND ABS([month_actual] - [total_actual]) &lt; 0.01, 1, 0)" field="chk_month_totals" size="4" type="Int32" /><FormulaField expression="IIF(ABS([ytd_last] - [net_variance]) &lt; 0.01, 1, 0)" field="chk_ytd_ends_at_net" size="4" type="Int32" /><FormulaField expression="IIF([gross_misses] + 0.01 &gt;= ABS([net_variance]), 1, 0)" field="chk_gross_ge_net" size="4" type="Int32" /><FormulaField expression="IIF([both_flags] = 0, 1, 0)" field="chk_flags_exclusive" size="4" type="Int32" /><FormulaField expression="IIF([pct_violations] = 0, 1, 0)" field="chk_pct_only_valid_budget" size="4" type="Int32" /><FormulaField expression='REGEX_Replace(&#10;  IIF([chk_rows_balance] = 0, "rows read &lt;&gt; kept + dropped; ", "") +&#10;  IIF([chk_dropped_reason] = 0, "a dropped row has no reason; ", "") +&#10;  IIF([chk_dept_totals] = 0, "department totals &lt;&gt; grand total; ", "") +&#10;  IIF([chk_month_totals] = 0, "monthly totals &lt;&gt; annual total; ", "") +&#10;  IIF([chk_ytd_ends_at_net] = 0, "YTD variance &lt;&gt; net variance; ", "") +&#10;  IIF([chk_gross_ge_net] = 0, "gross misses &lt; |net variance|; ", "") +&#10;  IIF([chk_flags_exclusive] = 0, "material and near-miss flags overlap; ", "") +&#10;  IIF([chk_pct_only_valid_budget] = 0, "variance % on a budget &lt;= 0; ", ""),&#10;";\s*$", "")' field="failed_checks" size="1000" type="V_String" /><FormulaField expression="IIF(IsEmpty([failed_checks]), 1, 0)" field="all_checks_pass" size="4" type="Int32" /><FormulaField expression="IIF([spend_rows] = 0, &quot;Pass&quot;,&#10;  IIF([allow_dropped_spend] = 1,&#10;    &quot;OVERRIDDEN: $&quot; + ToString([dropped_spend], 0, 1) + &quot; of actual spend&quot; +&#10;    IIF([unknown_actual_rows] &gt; 0, &quot; plus &quot; + ToString([unknown_actual_rows]) + &quot; row(s) whose actual couldn't be read&quot;, &quot;&quot;) +&#10;    &quot; dropped (see dropped_rows.csv)&quot;,&#10;    &quot;FAIL&quot;))" field="dropped_spend_status" size="1000" type="V_String" /></FormulaFields></Configuration><Annotation DisplayMode="0"><Name /><AnnotationText>Accuracy, 8 integrity checks, dropped-spend rule</AnnotationText><DefaultAnnotationText /><Left value="False" /></Annotation></Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>
