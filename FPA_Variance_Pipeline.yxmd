    <Node ToolID="46">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Message.Message"><Position x="2480" y="1275" /></GuiSettings>
      <Properties><Configuration><When>Filter</When><Filter>[dropped_spend_status] = "FAIL"</Filter><Type>Error</Type><Priority>High</Priority>
      <Transient>False</Transient><MessageExpression>"STOPPED: $" + ToString([dropped_spend], 0, 1) + " of actual spend" + IIF([unknown_actual_rows] &gt; 0, " plus " + ToString([unknown_actual_rows]) + " row(s) whose actual couldn't be read", "") + " is on rows that were dropped (" + ToString([spend_rows]) + " rows, listed in dropped_rows.csv). Fix the source files, or set allow_dropped_spend = 1 in the SETTINGS tool to report it and continue."</MessageExpression></Configuration><Annotation DisplayMode="0"><Name /><AnnotationText>Error if real spend was dropped</AnnotationText><DefaultAnnotationText /><Left value="False" /></Annotation></Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxMessage" />
    </Node>
