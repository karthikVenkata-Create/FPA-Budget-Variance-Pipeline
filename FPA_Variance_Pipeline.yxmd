    <Node ToolID="18">
      <GuiSettings Plugin="AlteryxBasePluginsGui.AppendFields.AppendFields"><Position x="840" y="340" /></GuiSettings>
      <Properties><Configuration><CartesianMode>Error</CartesianMode><SelectConfiguration><Configuration outputConnection="Output"><OrderChanged value="False" /><CommaDecimal value="False" /><SelectFields><SelectField field="*Unknown" selected="True" /></SelectFields></Configuration></SelectConfiguration></Configuration><Annotation DisplayMode="0"><Name /><AnnotationText>Attach settings to every row</AnnotationText><DefaultAnnotationText /><Left value="False" /></Annotation></Properties>
