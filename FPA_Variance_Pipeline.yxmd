      <Properties><Configuration><FormulaFields><FormulaField expression="IIF([budget] &gt; 0, [variance] / [budget], Null())" field="variance_pct" size="8" type="Double" /><FormulaField expression="1 - [gross_miss] / [budget]" field="gross_accuracy" size="8" type="Double" /><FormulaField expression='IIF([variance] &gt; 0, "Unfavorable", IIF([variance] &lt; 0, "Favorable", "On budget"))' field="fav_unfav" size="20" type="V_String" /><FormulaField expression="[max_month_budget] / [min_month_budget]" field="phasing_ratio" size="8" type="Double" /><FormulaField expression='IIF([phasing_ratio] &gt; [phasing_ratio_flag], "Question this phasing", "") +&#10;IIF([bad_budget_months] &gt; 0, IIF([phasing_ratio] &gt; [phasing_ratio_flag], "; ", "") + "has budget &lt;= 0 (ratio uses valid months only)", "")' field="phasing_flag" size="254" type="V_String" /></FormulaFields></Configuration><Annotation DisplayMode="0"><Name /><AnnotationText>Gross accuracy and budget phasing check</AnnotationText><DefaultAnnotationText /><Left value="False" /></Annotation></Properties>
